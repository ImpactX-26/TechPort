rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /applicants/{applicantId} {
      allow get: if isOwner(applicantId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(applicantId) 
                    && isValidId(applicantId) 
                    && incoming().id == request.auth.uid;
      allow update: if isOwner(applicantId) 
                    && isValidId(applicantId) 
                    && incoming().id == existing().id;
      allow delete: if isOwner(applicantId);
    }
  }
}
